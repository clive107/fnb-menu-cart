    "version": "0.2.0",
    "configurations": [
        {
            "name": "fnb_menu_cart",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart"
        },
        {
            "name": "fnb_menu_cart (forced checkout failure)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "--dart-define=FORCE_CHECKOUT_FAILURE=true"
            ]
        },
        {
            "name": "fnb_menu_cart (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "program": "lib/main.dart"
        },
        {
            "name": "fnb_menu_cart (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "program": "lib/main.dart"
        }
    ]
}
